DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=voting_db
DB_SSLMODE=disable

# Alternative: Use DATABASE_URL instead of individual DB_* variables
# DATABASE_URL=postgres://username:password@localhost:5432/voting_db?sslmode=disable

JWT_SECRET=your-super-secret-jwt-key-here
PORT=8080

# Comma-separated list of origins permitted to send cross-origin browser requests.
# Defaults to https://commonlawrepublic.us,https://www.commonlawrepublic.us when unset.
# For local dev add your dev hosts, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=https://commonlawrepublic.us,https://www.commonlawrepublic.us